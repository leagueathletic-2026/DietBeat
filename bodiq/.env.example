# --- Database (Supabase Postgres in production, local Postgres in dev) ---
DATABASE_URL=postgres://bodiq:bodiq_dev@127.0.0.1:5432/bodiq_dev

# --- Auth (server only) ---
AUTH_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me

# --- Data sources (server only, all optional until you add keys) ---
USDA_API_KEY=            # free key: https://fdc.nal.usda.gov/api-key-signup
OPENFOODFACTS_USER_AGENT="BODIQ/0.1 (contact: set-your-email)"
GOOGLE_PLACES_API_KEY=   # restaurant discovery
TAVILY_API_KEY=          # web search for menus / products (or EXA_API_KEY)
ANTHROPIC_API_KEY=       # AI-assisted matching + estimates
